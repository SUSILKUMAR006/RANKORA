{
  "name": "rankora",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "render-build": "npm --prefix backend install && npm --prefix frontend install && npm --prefix frontend run build",
    "start": "npm --prefix backend run start",
    "start:backend": "npm --prefix backend run start",
    "install:all": "npm --prefix backend install && npm --prefix frontend install"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
